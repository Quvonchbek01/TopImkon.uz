# TopImkon.uz environment variables (ARCHITECTURE.md section 16).
# Copy this file to .env.local and fill the values. Never commit .env.local.
# Only variables starting with NEXT_PUBLIC_ are visible in the browser.

# Public URL of the site (no trailing slash). Used for metadata and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (added in Stage 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Brevo, Stage 8) ---
BREVO_API_KEY=
EMAIL_FROM=

# --- Scheduled jobs (Stage 8) ---
CRON_SECRET=

# --- Rate limiting (Upstash, Stage 3) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection (Cloudflare Turnstile, Stage 3) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability (later stages) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Signed unsubscribe tokens (Stage 8) ---
UNSUBSCRIBE_SIGNING_SECRET=

# --- Local tooling ---
# The /dev/design page is hidden in production builds unless this is "true".
# Set it to "true" only for a short design review, then remove it again.
NEXT_PUBLIC_ENABLE_DESIGN_SYSTEM=false
